<Window x:Class="BevasarloLista.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BevasarloLista"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="GroceryTextBox" Grid.Row="0" Margin="10" KeyDown="KeyDownEnter"/>
        <Button x:Name="AddButton" Grid.Row="1" Content="Add" Click="AddButton_Click" />

        <ListBox x:Name="GroceryListBox" Grid.Row="2" Margin="10"/>
        <Label Content="Label" Margin="755,10,10,155" Grid.Row="2"/>
        
        <Button x:Name="DeleteButton" Grid.Row="3" Content="Delete" Margin="10,10,400,10"/>
        <Button x:Name="DeleteEveryButton" Grid.Row="3" Content="Delete All" Margin="400,10,10,10" Click="DeleteEveryButton_Click"/>
        

    </Grid>
</Window>
